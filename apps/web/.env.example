# Server-side base URL of a publisher's deployed PayCrawl gateway, without a trailing slash.
# This must be a public HTTPS DNS hostname. It is not exposed to the browser bundle.
PAYCRAWL_GATEWAY_URL=https://gateway.example

# Optional: enables the token-enforcing demo publisher origin at
# /api/demo-origin. Set this to the exact same secret as the gateway's
# ORIGIN_TOKEN, but only in the hosting provider's server-side environment.
# Use a fresh, high-entropy value of at least 32 characters. Never commit it.
PAYCRAWL_DEMO_ORIGIN_TOKEN=
