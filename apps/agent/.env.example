# The CLI creates this encrypted wallet file on first paid crawl and reuses it.
PAYCRAWL_WALLET_FILE=~/.paycrawl/wallets/payer-eip155-42220.json
# Keep this passphrase in the agent runtime's secret store. Never commit it.
PAYCRAWL_WALLET_PASSPHRASE=use-a-secret-of-at-least-16-characters
# The CLI writes explicit publisher approvals here. It stores public domains
# and payout addresses only; the wallet key remains in the encrypted wallet file.
PAYCRAWL_PUBLISHER_POLICY_FILE=~/.paycrawl/policies/publishers-eip155-42220.json
# Optional extra restriction for managed deployments. Leave unset for normal
# agent use; a new publisher still needs --approve-publisher on first use.
# PAYCRAWL_ALLOWED_PAY_TO=0x1111111111111111111111111111111111111111
